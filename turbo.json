{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env",
                "!README.md"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ],
            "env": [
                "BETTER_AUTH_SECRET",
                "BETTER_AUTH_GITHUB_CLIENT_ID",
                "BETTER_AUTH_GITHUB_CLIENT_SECRET",
                "BETTER_AUTH_GOOGLE_CLIENT_ID",
                "BETTER_AUTH_GOOGLE_CLIENT_SECRET",
                "POSTGRES_URL",
                "RESEND_API_KEY",
                "EMAIL_FROM",
                "NEXT_PUBLIC_APP_URL"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ],
            "inputs": [
                "$TURBO_DEFAULT$"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}