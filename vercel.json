{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm build",
    "devCommand": "pnpm dev",
    "installCommand": "pnpm install",
    "framework": "nextjs",
    "git": {
        "deploymentEnabled": {
            "main": true,
            "preview": true
        }
    },
    "env": {
        "NEXT_PUBLIC_APP_ENV": {
            "value": "development"
        }
    },
    "preview": {
        "env": {
            "NEXT_PUBLIC_APP_ENV": {
                "value": "preview"
            },
            "NODE_ENV": {
                "value": "production"
            }
        }
    },
    "production": {
        "env": {
            "NEXT_PUBLIC_APP_ENV": {
                "value": "production"
            },
            "NODE_ENV": {
                "value": "production"
            }
        }
    }
}