{
    "name": "helix-monorepo",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "build:web": "turbo run build --filter=@helix/web",
        "build:mobile": "turbo run build --filter=@helix/mobile",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@helix/web",
        "dev:mobile": "turbo run dev --filter=@helix/mobile",
        "lint": "turbo run lint",
        "lint:web": "turbo run lint --filter=@helix/web",
        "lint:mobile": "turbo run lint --filter=@helix/mobile",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate",
        "db:push": "turbo run db:push",
        "db:studio": "turbo run db:studio",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
        "test": "turbo run test",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:web": "turbo run test --filter=@helix/web",
        "test:api": "turbo run test --filter=@helix/api",
        "test:mobile": "turbo run test --filter=@helix/mobile",
        "test:e2e": "turbo run test:e2e --filter=@helix/web"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.9",
        "prettier": "^3.5.3",
        "turbo": "^2.7.4",
        "typescript": "^5.8.2",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.9"
    },
    "packageManager": "pnpm@9.7.0"
}