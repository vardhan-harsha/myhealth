# PRODUCTION ENVIRONMENT CONFIGURATION
# This file contains environment variables for the production environment
# Copy this to .env.production and fill in your production values

# =============================================================================
# ENVIRONMENT
# =============================================================================
NEXT_PUBLIC_APP_ENV="production"
NODE_ENV="production"

# =============================================================================
# BETTER AUTH
# =============================================================================
# Generate a strong secret for production: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Production OAuth Apps (use production OAuth app credentials)
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

BETTER_AUTH_MICROSOFT_CLIENT_ID=""
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=""

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
# Production Resend API key
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# =============================================================================
# DATABASE
# =============================================================================
# Production database URL (use a managed database service)
# Example: Vercel Postgres, Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@production-db-host:5432/helix_production"
