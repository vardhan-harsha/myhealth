{
    "name": "@helix/db",
    "version": "0.1.0",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "license": "MIT",
    "scripts": {
        "clean": "rm -rf .turbo node_modules",
        "lint": "eslint .",
        "format": "prettier --check \"**/*.{mjs,ts,md,json}\"",
        "push": "dotenv -e ../../apps/web/.env -- drizzle-kit push",
        "studio": "dotenv -e ../../apps/web/.env -- drizzle-kit studio",
        "generate": "dotenv -e ../../apps/web/.env -- drizzle-kit generate",
        "migrate": "dotenv -e ../../apps/web/.env -- tsx migrate.ts",
        "create-tables": "dotenv -e ../../apps/web/.env -- tsx create-tables.ts"
    },
    "dependencies": {
        "@t3-oss/env-core": "^0.11.1",
        "drizzle-orm": "^0.41.0",
        "postgres": "^3.4.4",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "dotenv-cli": "^7.3.0",
        "drizzle-kit": "^0.30.5",
        "eslint": "^9.23.0",
        "prettier": "^3.5.3",
        "tsx": "^4.21.0",
        "typescript": "^5.8.2"
    }
}