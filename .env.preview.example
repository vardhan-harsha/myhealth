# PREVIEW ENVIRONMENT CONFIGURATION
# This file contains environment variables for the preview/staging environment
# Copy this to .env.preview and fill in your preview-specific values

# =============================================================================
# ENVIRONMENT
# =============================================================================
NEXT_PUBLIC_APP_ENV="preview"
NODE_ENV="production"

# =============================================================================
# BETTER AUTH
# =============================================================================
# Generate a new secret for preview: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Preview OAuth Apps (create separate OAuth apps for preview)
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

BETTER_AUTH_MICROSOFT_CLIENT_ID=""
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=""

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
# Use the same Resend API key or create a separate one for preview
RESEND_API_KEY=""
EMAIL_FROM="preview@yourdomain.com"

# =============================================================================
# DATABASE
# =============================================================================
# Preview database URL (separate database from production)
# Example: Vercel Postgres, Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://user:password@preview-db-host:5432/helix_preview"
