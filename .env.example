# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: "development" | "preview" | "production"
# This helps identify which environment the app is running in
NEXT_PUBLIC_APP_ENV="development"

# =============================================================================
# BETTER AUTH
# =============================================================================
# Secret used by Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Better Auth Google OAuth
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Better Auth Microsoft OAuth
BETTER_AUTH_MICROSOFT_CLIENT_ID=""
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=""

# =============================================================================
# EMAIL (RESEND)
# =============================================================================
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# =============================================================================
# DATABASE
# =============================================================================
# Development (local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/helix"

# Preview Environment (optional - set in .env.preview or Vercel)
# DATABASE_URL="postgresql://user:password@preview-db-host:5432/helix_preview"

# Production Environment (optional - set in .env.production or Vercel)
# DATABASE_URL="postgresql://user:password@production-db-host:5432/helix_production"
